FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

EXPOSE 3000

# This image runs the Vite dev server (with live reload via the bind-mounted
# volume in docker-compose.yml). There is no point running a production
# `vite build` here since it is never served. For an actual production
# deployment, build a static bundle with `npm run build` and serve `dist/`
# from a lightweight web server (e.g. nginx) instead.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]